<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon background layer: a diagonal indigo -> violet gradient.
  Kept as a vector so the adaptive icon stays crisp at every density.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:color="#FF4F46E5" android:offset="0" />
                <item android:color="#FF7C3AED" android:offset="0.55" />
                <item android:color="#FF9333EA" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
