<?xml version="1.0" encoding="utf-8"?>
<!--
  AgentPaw App Icon Background Layer
  Modern high-end gradient with radial ambient lighting and subtle neon glow.
  Complies with 108dp x 108dp adaptive icon canvas specifications.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base dynamic gradient layer: Indigo -> Violet -> Fuchsia -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:color="#FF4338CA" android:offset="0.0" />
                <item android:color="#FF6366F1" android:offset="0.3" />
                <item android:color="#FF7C3AED" android:offset="0.65" />
                <item android:color="#FF9333EA" android:offset="0.85" />
                <item android:color="#FFC026D3" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top-left subtle ambient light circle -->
    <path
        android:fillAlpha="0.25"
        android:pathData="M16,20a38,38 0 1,0 76,0a38,38 0 1,0 -76,0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="26"
                android:gradientRadius="38">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft bottom-right neon warmth -->
    <path
        android:fillAlpha="0.30"
        android:pathData="M24,78a42,42 0 1,0 84,0a42,42 0 1,0 -84,0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="66"
                android:centerY="84"
                android:gradientRadius="42">
                <item android:color="#FFFF70A6" android:offset="0.0" />
                <item android:color="#00FF70A6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
