    <!-- Expert mode: high-risk switches -->
    <string name="settings_high_risk_group">High-risk switches</string>
    <string name="settings_high_risk_intro">These switches relax the default safety boundary. Every one is off by default, and turning one on requires acknowledging the concrete risk.</string>
    <string name="settings_allow_http">Allow HTTP transport</string>
    <string name="settings_allow_http_summary">Permit cleartext http:// requests. API keys and prompts travel unencrypted.</string>
    <string name="settings_allow_public_http">Allow public cleartext HTTP</string>
    <string name="settings_allow_public_http_summary">Extends cleartext HTTP to public hosts. Requires the switch above.</string>
    <string name="settings_allow_shell_skills">Allow skills to run Root commands</string>
    <string name="settings_allow_shell_skills_summary">Skills containing shell steps may execute as root. Requires ROOT mode.</string>
    <string name="settings_allow_sensitive_screen">Allow sensitive screens</string>
    <string name="settings_allow_sensitive_screen_summary">Skills keep running on payment or password pages instead of pausing.</string>
    <string name="settings_risk_bypass">Temporarily skip risk confirmations</string>
    <string name="settings_risk_bypass_summary">Suppresses the confirmation card for up to %1$d minutes, then expires automatically.</string>
    <string name="settings_risk_bypass_active">Active · %1$d min left</string>
    <string name="settings_risk_bypass_off">Off</string>
    <string name="settings_risk_bypass_action">Enable for 15 min</string>
    <string name="settings_risk_bypass_stop">Stop</string>
    <string name="settings_high_risk_active_banner">%1$d high-risk switches are on</string>
    <string name="risk_dialog_title">Turn on “%1$s”?</string>
    <string name="risk_dialog_ack">I understand the risk and want to enable it anyway</string>
    <string name="risk_dialog_confirm">Enable</string>
    <string name="risk_http">Cleartext HTTP sends your API key and the whole conversation in plain text. Anyone on the same network can read or modify them.</string>
    <string name="risk_public_http">Public cleartext HTTP exposes credentials to every hop on the internet path. Only acceptable inside a lab.</string>
    <string name="risk_shell">A Root command can modify or destroy system files and is not sandboxed. One malformed step can brick the device.</string>
    <string name="risk_sensitive">Payment and password screens will be automated without the usual pause. One wrong tap can spend money or submit credentials.</string>
    <string name="risk_bypass">Risk confirmation is the last line of defence before payments, deletions and sends. Skipping it lets the model act immediately.</string>
    <string name="settings_root_required">Requires ROOT execution mode — enable it above first.</string>

