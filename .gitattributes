# Normalise line endings so the wrapper scripts stay executable on Unix.
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.pro text eol=lf
*.properties text eol=lf

gradlew text eol=lf
*.bat text eol=crlf

*.jar binary
*.png binary
*.webp binary
